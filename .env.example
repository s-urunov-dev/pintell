# ---------------------------------------------------------------------------
# Copy this file to .env and adjust the values. NEVER commit the real .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate a fresh one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-before-any-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC

# --- CORS / CSRF (frontend origins allowed to call the API) ----------------
# :3000 public site, :3001 operator console, :5173/:5174 their dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5174

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=tenders
POSTGRES_USER=tenders
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional: full URL overrides the discrete settings above.
# Example for a local SQLite run without Docker: sqlite:///db.sqlite3
# DATABASE_URL=postgres://tenders:change-me-in-production@db:5432/tenders

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Focus filters (stage-1 scope) -----------------------------------------
# The actionable feed = open deadline + Request for Expression of Interest /
# Invitation for Bids + this country group. Widen it here, not in code.
FOCUS_COUNTRY_GROUP=cis_plus
FOCUS_OPEN_ONLY=true
# Whether the group also bounds what is *stored*. On, a notice from any other
# country is dropped before it is written, and the mirror only ever holds the
# focus region. Off, the whole World Bank archive is mirrored and the group is
# a display filter — which is what this was before the scope narrowed.
# Turning it off widens future syncs; it does not bring back deleted rows.
INGEST_FOCUS_ONLY=true

# --- Claude (optional) ------------------------------------------------------
# One key, two unrelated consumers, each with its own switch:
#
#   compliance extraction  — the product. Runs as soon as the key is present.
#   category classifier    — a nicety. Stays OFF unless AI_CLASSIFY_ENABLED,
#                            because it has a Celery schedule over the whole
#                            mirror (25,000+ notices) and would otherwise start
#                            spending the moment a key appeared.
#
# Without a key nothing breaks: categories fall back to keyword rules, the
# supplier-website lookup is skipped, and compliance extraction records
# "no API key configured" instead of raising.
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# The chat's model, when it should not be extraction's. Empty means AI_MODEL.
# The two pull opposite ways: extraction is offline and graded, so the
# cheapest passing tier wins; the chat writes Uzbek and Russian prose a
# vendor reads, which nothing in the pipeline measures.
AI_CHAT_MODEL=
# Routing between two tiers by how hard the question is (D60). A lookup —
# "aloqa uchun pochta qanday?" — and an analysis are not the same job.
#
# **Empty is the shipped default and it means no routing happens**, which is
# deliberate: the cost of the other setting is already measured. The deployed
# server once ran the whole chat on Haiku and the Uzbek came back
# ungrammatical — "zarorat", "savdo-sotuvchi shartlari" — a quality the
# citation schema cannot check and no prompt can fix. So the recommended fast
# tier is claude-sonnet-5, not the cheapest model that answers, and anything
# the router does not recognise goes to the capable tier either way.
AI_CHAT_MODEL_FAST=
AI_CHAT_MODEL_DEEP=
AI_CHAT_EFFORT_FAST=low
AI_CHAT_EFFORT_DEEP=medium
# Leave off for the demo. Turning it on classifies the archive, on Opus.
AI_CLASSIFY_ENABLED=false

# Rule confidence at or above this never reaches the model (cost control).
AI_CLASSIFY_RULE_THRESHOLD=0.55
AI_CLASSIFY_EFFORT=low
AI_CLASSIFY_BATCH_SIZE=40
# Supplier-website discovery runs live web searches — keep the batch small.
AI_ENRICH_EFFORT=low
AI_ENRICH_BATCH_SIZE=10
AI_ENRICH_MAX_SEARCHES=3

# --- Compliance extraction --------------------------------------------------
# Reads the qualification criteria of tenders that are still open, after every
# sync. With no key it runs L1 only (free, no network); with a key it runs
# L1+L2+L3. Bounded by the number of open tenders — around thirty — not by the
# size of the mirror.
COMPLIANCE_AUTO_EXTRACT=true
COMPLIANCE_AUTO_BATCH_SIZE=25

# --- Web-search provider (people + website lookups) -------------------------
# These two features need a model that can search the web, and either provider
# can serve them. Gemini is here because its free tier bundles the Google
# Search grounding, so the enrichment can be run at no cost — get a key at
# https://ai.google.dev/. Claude is the better model if you are paying anyway.
#
# auto = use whichever key is set, preferring the free one (gemini).
# Set explicitly to pin a provider; a pinned provider with no key simply
# disables the feature rather than silently falling back to the other.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120

# --- Enrichment scheduling -------------------------------------------------
ENRICHMENT_ENABLED=true
ENRICHMENT_INTERVAL_MINUTES=15

# --- World Bank sync -------------------------------------------------------
WORLDBANK_API_URL=https://search.worldbank.org/api/v2/procnotices
# Project metadata and the documents archive (used for project documents/ESRS).
WORLDBANK_PROJECTS_API_URL=https://search.worldbank.org/api/v2/projects
WORLDBANK_DOCUMENTS_API_URL=https://search.worldbank.org/api/v3/wds
# Page size per upstream request (upstream is comfortable with 50-100).
SYNC_ROWS_PER_PAGE=100
# How many pages one sync run pulls (100 x 25 = 2500 newest-ish notices).
SYNC_MAX_PAGES=25
# Pages per country when the sync runs filtered (INGEST_FOCUS_ONLY above).
SYNC_FOCUS_PAGES_PER_COUNTRY=2
# Period of the recurring Celery task, in minutes.
SYNC_INTERVAL_MINUTES=30
# HTTP timeout (seconds) for a single upstream request.
SYNC_HTTP_TIMEOUT=30
# Fire one sync immediately when the backend container starts (so you do not
# have to wait for the first scheduled run).
INITIAL_SYNC_ENABLED=true

# --- Project mirror (financing, documents, ESRS) ---------------------------
# A project keeps gaining documents for years after its first notice, and the
# ESRS often lands much later, so a mirrored profile is re-fetched once it is
# this many days old.
PROJECT_REFRESH_DAYS=14
# Projects mirrored per enrichment cycle (two upstream requests each).
PROJECT_SYNC_BATCH_SIZE=20
# Retry backoff after a failed attempt: BASE * 2^(failures-1), capped by MAX.
PROJECT_RETRY_BASE_MINUTES=60
PROJECT_RETRY_MAX_DAYS=7
# Opening a notice whose project is not mirrored queues one on demand. This is
# how long that request holds its per-project lock, so a hundred readers of the
# same notice produce one job — and a failing project is asked for at most once
# per window.
PROJECT_ONDEMAND_LOCK_SECONDS=600

# --- Document harvesting ---------------------------------------------------
# The TOR and bidding documents a notice links to are hosted by the borrower,
# not by the Bank, and they stop answering once the tender closes. Collecting
# them is therefore time-critical: what is missed cannot be fetched later.
HARVEST_ENABLED=true
# Where the raw bytes land, content-addressed by SHA-256. Mount this as a
# volume in production — it is the one directory that cannot be regenerated.
HARVEST_DIR=./data/harvest
# Documents fetched per cycle, and how often a cycle runs (Celery Beat).
HARVEST_BATCH_SIZE=25
HARVEST_INTERVAL_MINUTES=10
HARVEST_HTTP_TIMEOUT=60
# Hard ceiling on one download (60 MB). Bidding documents are large; anything
# past this is a mis-linked archive or a video.
HARVEST_MAX_BYTES=62914560
# Seconds between two requests to the same host. These are ministry file
# servers, not APIs with a published quota — keep this gentle.
HARVEST_PER_HOST_DELAY=1.5
# Extracted text kept per document.
HARVEST_MAX_TEXT_CHARS=400000
# Retry backoff after a failed fetch: BASE * 2^(attempts-1), capped by MAX.
# A link behind a sign-in wall is retried too — borrowers often open the
# folder up a few days after publishing it.
HARVEST_RETRY_BASE_MINUTES=120
HARVEST_RETRY_MAX_DAYS=3

# --- Historical archive backfill -------------------------------------------
# The incremental sync above only sees the newest pages. The backfill walks the
# whole archive (~413k notices, back to the late 1990s) in resumable slices.
# Upstream refuses any offset above 100000, so history is pulled per country.
BACKFILL_ENABLED=true
# Pages per slice and how often a slice runs (Celery Beat).
BACKFILL_PAGES_PER_RUN=40
BACKFILL_INTERVAL_MINUTES=5
# Pause between upstream pages — the archive walk issues thousands of requests,
# so it stays deliberately gentle on a public open-data service.
BACKFILL_PAGE_DELAY=0.25
# Upstream ($skip) hard limit. Do not raise; it is enforced by the API.
SYNC_MAX_OFFSET=100000

# --- Django admin bootstrap (created on first start if all three are set) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# --- API throttling (DRF) --------------------------------------------------
API_THROTTLE_ANON=120/min
# Operator console: login attempts and job triggers get their own budgets.
ADMIN_LOGIN_THROTTLE=10/min
ADMIN_ACTION_THROTTLE=30/min

# --- Operator console sessions ---------------------------------------------
# The console at /console authenticates with a Django session cookie and is
# restricted to accounts with is_staff. Use the DJANGO_SUPERUSER_* values above
# for the first operator account.
SESSION_COOKIE_AGE=43200
SESSION_EXPIRE_AT_BROWSER_CLOSE=false
# Keep "Lax" unless the console is served from a different site than the API.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# With DJANGO_DEBUG off these default to true, which is correct behind TLS.
# Turn them off only for a deployment reached over plain http:// — a browser
# still replays Secure cookies on localhost, but nothing else does, so a curl
# or scripted client cannot hold a console session while they are on.
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false

# --- Frontends -------------------------------------------------------------
# Both apps call the API through a relative "/api" path, which their own nginx
# (docker) and Vite dev-server proxies forward to Django. Keeping them
# same-origin with the API is what lets the console's session cookie stay
# SameSite=Lax; point these elsewhere only if you also relax that policy.
VITE_API_BASE_URL=
ADMIN_VITE_API_BASE_URL=

# Published host ports. Bind the console to 127.0.0.1 in docker-compose.yml if
# it should not be reachable from the network.
FRONTEND_PORT=3000
ADMIN_FRONTEND_PORT=3001
BACKEND_PORT=8000

# Link shown in the console's sidebar; leave empty to hide it.
PUBLIC_SITE_URL=http://localhost:3000

# --- Semantic index (Qdrant + embeddings) ----------------------------------
# Retrieval over the mirrored notices and the documents they link to, with the
# page coordinates a viewer needs to highlight what it cites. It is a cache:
# every vector is rebuildable with `manage.py archive_to_qdrant`, nothing in it
# reaches a compliance verdict, and a Qdrant that is down degrades search to a
# Postgres full-text fallback rather than failing.
#
# OFF by default. Turning it on starts spending an embedding quota over tens of
# thousands of notices — a key is permission to spend, never an instruction to.
# Cost the run first:
#     python manage.py archive_to_qdrant --dry-run
RAG_ENABLED=false

# The local container from docker-compose.yml.
#
# QDRANT_API_KEY is the *client* half of a pair. Setting it here alone changes
# nothing: the server only demands a key when QDRANT__SERVICE__API_KEY is
# uncommented in docker-compose.yml, and that variable must never be set to an
# empty string — an empty value switches authentication on and then rejects
# every request, this stack's included.
#
# Do set both for any deployment where port 6333 is reachable by anything other
# than this compose network: with no key, Qdrant serves an unauthenticated API
# and an unauthenticated web dashboard.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_HOST_PORT=6333
# Pinned, and kept in step with `qdrant-client` in backend/requirements.txt:
# the client warns on every call once the two drift by more than a minor
# version, and a warning nobody reads is how the real incompatibility is missed.
#
# Bumping this means dropping the volume — a newer server will not load storage
# an older one wrote, and the container restart-loops instead. See the recipe in
# docker-compose.yml; it costs one re-run of archive_to_qdrant and nothing else.
QDRANT_IMAGE=qdrant/qdrant:v1.19.0

RAG_COLLECTION=notice_chunks
# The collection's vector width AND the width requested from the model, from
# this one variable. In Qdrant the width is fixed at creation, so a mismatch is
# a rejected upsert at best. Changing it (or RAG_EMBED_MODEL) marks everything
# already embedded as stale — vectors from two models are not comparable, and a
# collection holding both returns nonsense for whichever half did not match.
RAG_VECTOR_SIZE=768
# Gemini, asked for 768 dimensions so it matches RAG_VECTOR_SIZE above.
# NOT `text-embedding-004` — that model is retired and the API 404s on it.
RAG_EMBED_MODEL=gemini-embedding-001
# Falls back to GEMINI_API_KEY when empty. Set it separately to give the index
# its own quota — the enrichment path and this one have very different volumes.
RAG_EMBED_API_KEY=
RAG_EMBED_TIMEOUT=120
RAG_EMBED_BATCH=100
RAG_EMBED_MAX_CHARS=8000
RAG_EMBED_MAX_RETRIES=5
# **Texts** per minute the embedder will not exceed; 0 is unpaced.
#
# Texts, not HTTP calls. Gemini's batch endpoint calls each text in the batch a
# "request" (`at most 100 requests can be in one batch`) and the quota counts
# those — one call carrying 100 texts spends the whole free-tier minute.
# Verified against the live endpoint: 100 texts in one call returns 200, ten
# more a second later returns 429.
#
# Free tier is 100/min, which puts a ~112,000-chunk archive at about nineteen
# hours. **Batching does not change that — only enabling billing does**, after
# which the same run is roughly an hour and costs about $3. Set ~95 while on
# the free tier; leave 0 once billing is on.
RAG_EMBED_TEXTS_PER_MINUTE=0
# Embedding requests in flight at once; 1 is sequential.
#
# Raise this only together with lifting the pace above. While a per-minute
# budget binds, threads just queue behind it. With billing on, latency binds
# instead: one call carrying 100 texts takes tens of seconds, so a sequential
# stream indexes ~75 chunks a minute — about a day for this archive — while 8
# in flight brings the same work to roughly an hour.
RAG_EMBED_CONCURRENCY=1
RAG_EMBED_BACKOFF_BASE=1.5
RAG_UPSERT_BATCH=256

# Chunking. A target, not a maximum: a chunk never splits a sentence or spans
# two pages, because its position has to be one contiguous range in one
# coordinate system for the highlight to be truthful.
RAG_CHUNK_CHARS=900
RAG_MIN_CHUNK_CHARS=80
# Sentences repeated between neighbouring chunks. Off: the cut is already on a
# sentence boundary, and overlapping ranges mean one passage returned twice.
RAG_CHUNK_OVERLAP=0

RAG_SEARCH_LIMIT=5
RAG_SEARCH_MAX_LIMIT=50
# Passages the chat puts in front of the model. Sixteen because at eight a
# general question was answered from three or four distinct notices once
# near-duplicate template paragraphs were counted.
RAG_CHAT_PASSAGES=16
# Cosine always returns something. Below this floor a result is dropped rather
# than shown under a citation badge that would make it look sourced.
RAG_SCORE_THRESHOLD=0.5
# Its own throttle: every search is a metered embedding call, unlike every
# other anonymous endpoint, which only reads the mirror.
RAG_SEARCH_THROTTLE=30/min

# Keeping the index current without a hand-run import. Notices only, bounded
# per run: a notice synced after the last import is otherwise unsearchable,
# unanswerable in chat, and has no similar-awards panel.
RAG_AUTO_INDEX=true
RAG_AUTO_INDEX_INTERVAL_MINUTES=20
RAG_AUTO_INDEX_LIMIT=60

# --------------------------------------------------------------------------
# Answering a question that has already been answered (D57)
# --------------------------------------------------------------------------
# Two shapes of one question — "Silva e-maili qanday?" and "Silvaning pochtasi
# nima?" — get one answer and one model call. Its own Qdrant collection: a
# stored answer is not a passage, and nothing in it can ever be cited.
RAG_CACHE_ENABLED=true
RAG_CACHE_COLLECTION=chat_cache
# Cosine at or above this serves the stored answer. High on purpose: the reader
# is shown the earlier answer verbatim, so the two questions have to *mean* the
# same thing rather than merely be about it.
#
# Measured against the live archive with gemini-embedding-001 at 768 dims,
# storing "Silva e-maili qanday?" — 0.9721 for "Silva e-mail manzili qanday?",
# 0.8691 for "Silvaning elektron pochtasi qanday?", 0.7727 for "Silvaning
# pochtasi nima?", 0.5267 for an unrelated question. So 0.92 serves
# near-identical rewordings and **not** looser Uzbek synonymy. Lowering it into
# the 0.77–0.87 band is a decision for the gold set: a miss costs one model
# call, a false hit costs a wrong answer served instantly under citations.
RAG_CACHE_THRESHOLD=0.92
# How long an answer may be served. The archive moves underneath it — a tender
# closes, a notice is synced — so this is the window in which a cached answer
# is still a claim about the corpus it was written from. An answer that cites a
# database record ("22 tenders are open") is never cached at all, at any TTL.
RAG_CACHE_TTL_SECONDS=21600
RAG_CACHE_MAX_ENTRIES=5000

# --------------------------------------------------------------------------
# Hybrid retrieval (D58)
# --------------------------------------------------------------------------
# Dense and keyword search, fused by *rank* — never by score, which is the one
# thing the search module refuses. On by default because the failure it fixes
# is total: a tender reference like TRIP-CS-01 has no semantic neighbourhood,
# so the dense arm returns notices about consulting selection and never the
# notice the reader named.
RAG_HYBRID=true
# Reciprocal Rank Fusion's smoothing constant, as the paper measured it.
RAG_RRF_K=60
RAG_HYBRID_CANDIDATES=20
# Notices the keyword arm ranks. `ts_rank` recomputes a tsvector per matching
# row, so its cost follows the match count, not the result count: measured on
# the 25,463-notice mirror, "annual turnover requirement" matches 697 and
# ranking all of them took 570 ms. Sampling first: 168 ms at 200, 250 ms at
# 300, 374 ms at 400. Above the cap the best-ranked notice is no longer certain
# to be in the sample — which is the trade, stated.
RAG_LEXICAL_RANK_CAP=300

# Rank from the stored `search_vector` tsvector column instead of
# recomputing `to_tsvector` for every matching row. Measured on a staging
# copy of production: the same 300-row ranking at 68 ms rather than 652.
#
# **This is a cutover and the order matters.** The column arrives empty
# (tenders migration 0023) and a trigger (0024) only fills rows as they
# are written. Deploy, then:
#
#     python manage.py backfill_search_vector            # fills, batched
#     python manage.py backfill_search_vector --status   # must say 0 left
#
# and only then set this true. Switching it on early does not make search
# slow or noisy — it makes it quietly return fewer notices, because a row
# whose vector is null does not match at all.
RAG_LEXICAL_STORED_VECTOR=false

# Minutes between warm-up probes of the vector store. 0 turns it off.
# The deployed server's first search after an idle spell took 2.1 s
# against 32 ms warm: an idle box lets the kernel reclaim the pages Qdrant
# memory-maps. The probes use fixed vectors and call no embedding API.
RAG_WARM_INTERVAL_MINUTES=5

# --------------------------------------------------------------------------
# Reranking (D59) — off, and turning it on is a decision, not a default
# --------------------------------------------------------------------------
# `none` | `cohere` | `local`. A cross-encoder reads the question and the
# passage *together*, which retrieval never does — but `local`
# (bge-reranker-v2-m3) needs torch in the image, and `cohere` needs an account
# and a third party nobody has asked the legal side about. Both are
# implemented; neither is switched on by a machine.
RAG_RERANK_BACKEND=none
RAG_RERANK_MODEL=bge-reranker-v2-m3
RAG_RERANK_API_KEY=
RAG_RERANK_TIMEOUT=15
# Passages that survive a rerank. Only applied when one actually ran: with the
# backend off the chat keeps the sixteen passages D49 measured, rather than
# taking the smaller number without the machinery that earns it.
RAG_RERANK_TOP_N=5

# Characters of one passage in the prompt, after markup and whitespace are
# stripped out of it. Words, figures and currency codes are never touched —
# the prompt asks the model to quote amounts exactly as the source writes them.
RAG_PASSAGE_MAX_CHARS=1200

# Cut an uploaded document on its own headings and keep its tables whole (D61).
# Uploads only: re-chunking the mirrored archive would move every offset in it
# and mean re-embedding 74,000 chunks for structure notice bodies do not have.
RAG_STRUCTURAL_CHUNKING=true
